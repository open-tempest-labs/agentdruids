# Dependencies
node_modules

# Build output
dist
frontend/dist
build

# Environment variables (contains secrets)
.env
.env.local
.env.*.local
.env.backup

# Backup, scratch, and disabled source files (do not commit)
*.bak
*.bak2
*.backup
*.disabled
*.corrupt
*.temp
*.orig

# Runtime data and volumes
data
host
logs

# Coordination session result dumps
coordination_result_*.json

# Debug and scratch files
debug*.html
debug*.js
modal-debug*.html
verify_*.js

# HTTP debug artifacts
cookies.txt
headers.txt

# Per-contributor Claude Code settings (opt-in from .claude/settings.example.json)
.claude/settings.local.json

# Local record that a seam audit ran against a specific commit (see .claude/commands/seam-audit.md)
.claude/.seam-audit
